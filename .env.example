# Copy to .env. Every setting uses the RE_AI_ prefix (src/core/config.py).
RE_AI_ENV=local
RE_AI_DATABASE_URL=postgresql+asyncpg://revenue_ai:revenue_ai@localhost:5433/revenue_ai
# Vector database (Qdrant). Empty URL: embedded, stored in RE_AI_QDRANT_PATH (one service process only).
# For several replicas run a Qdrant server and set its URL (and API key).
RE_AI_QDRANT_URL=
RE_AI_QDRANT_PATH=.qdrant
# RE_AI_QDRANT_API_KEY=

# OpenAI (chat only). Keep the model pinned to a dated snapshot so output stays stable.
RE_AI_OPENAI_API_KEY=
# Empty: OpenAI. Or an OpenAI-compatible gateway, e.g. https://<gateway>/v1
RE_AI_OPENAI_BASE_URL=
# responses (OpenAI) | chat_completions (gateways without the Responses API, e.g. Yantra)
RE_AI_LLM_API=responses
# Output budget per call for chat_completions (reasoning included); gateways' defaults are too low.
# RE_AI_MAX_OUTPUT_TOKENS=32000
RE_AI_CHAT_MODEL=gpt-5.5-2026-04-23
# Free local embeddings (fastembed); the model (~70 MB) is downloaded once on first use.
RE_AI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RE_AI_EMBEDDING_CACHE_DIR=.models
RE_AI_EXTRACTION_EFFORT=medium
RE_AI_DRAFTING_EFFORT=medium
RE_AI_CLARIFICATION_EFFORT=low
RE_AI_REVIEW_EFFORT=medium
# Only for non-reasoning models (e.g. gpt-4.1); leave unset for gpt-5.x.
# RE_AI_TEMPERATURE=0
RE_AI_MAX_PARALLEL_LLM_CALLS=8

# Shared with the backend, which signs a short-lived token per call (issuer revenue-engine-api).
RE_AI_SERVICE_TOKEN_SECRET=change-me-to-a-long-random-string
RE_AI_SERVICE_TOKEN_AUDIENCE=revenue-engine-ai
# RE_AI_SERVICE_TOKEN_ISSUER=revenue-engine-api
# Job callbacks are signed with this; must equal the backend's RE_AI_CALLBACK_SECRET (locally its dev default).
RE_AI_CALLBACK_SECRET=dev-only-insecure-ai-callback-secret-change-me
# A job's file_url must start with one of these (the backend's object storage: MinIO locally, S3 in production).
# RE_AI_FILE_URL_PREFIXES=["http://localhost:9000/","http://127.0.0.1:9000/"]
# RE_AI_MAX_PARALLEL_JOBS=4
# Scanned PDF pages read with OCR per document (0 = no OCR).
# RE_AI_OCR_MAX_PAGES=100
# Reasoning effort of the Final Proposal Check Agent (kept low: target under 30 s).
RE_AI_FINAL_CHECK_EFFORT=low
